APP_NAME=Hospital Management System
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=CHANGE-ME-TO-A-LONG-RANDOM-SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=20
DATABASE_URL=postgresql+psycopg://hms_user:change-me@localhost:5432/hms_db
CORS_ORIGINS=http://localhost:3000
DEFAULT_CURRENCY=PKR
HOSPITAL_TIMEZONE=Asia/Karachi
DEV_SEED_PASSWORD=ChangeMe-Local-Only-123
HMS_BIND_ADDRESS=127.0.0.1

# Supabase (cloud). The secret key is server-only: never put it in apps/web.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Supabase database (Connect > Session pooler URI, with your database password).
# When set, ALL data is stored in Supabase and no local database is started.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
